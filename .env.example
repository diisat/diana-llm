GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# A shared random secret, also set as CHAT_SERVICE_TOKEN on the portfolio server.
CHAT_SERVICE_TOKEN=
CHAT_REQUESTS_PER_MINUTE=20
CHAT_REQUESTS_PER_DAY=200

# RAM-only public FAQ answer cache. Set TTL or entries to 0 to disable.
CHAT_CACHE_TTL_SECONDS=86400
CHAT_CACHE_MAX_ENTRIES=128
